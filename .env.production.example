# Set these as Environment Variables in your Vercel project settings

# Your Railway backend URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app

# Razorpay publishable key (safe to expose)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Cloudinary cloud name (safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Extra image hosts (comma-separated) for products whose image was attached by
# URL rather than uploaded. next/image only optimises hosts listed here plus
# Cloudinary — anything else renders broken. Wildcards allowed.
# NEXT_PUBLIC_EXTRA_IMAGE_HOSTS=cdn.supplier.com,**.othersite.in
